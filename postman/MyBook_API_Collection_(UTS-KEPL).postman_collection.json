  "item": [
    {
      "name": "01 - Login Admin (Login)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Token returned and saved to variable\", function () {\r",
              "    const response = pm.response.json();\r",
              "    pm.expect(response.status).to.eql(\"success\");\r",
              "    pm.expect(response.data.token).to.be.a(\"string\");\r",
              "\r",
              "    // Simpan token otomatis ke Collection Variable 'token'\r",
              "    pm.collectionVariables.set(\"token\", response.data.token);\r",
              "    console.log(\"Token Sanctum berhasil disimpan:\", response.data.token);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"admin@mybook.test\",\r\n  \"password\": \"password123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "login"
          ]
        }
      },
      "response": []
    },
